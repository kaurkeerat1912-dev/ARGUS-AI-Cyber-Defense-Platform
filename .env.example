# ==============================================================================
# ARGUS CYBER DEFENSE PLATFORM — ENVIRONMENT EXAMPLE CONFIGURATION
# Copy this file to .env and insert your local configuration values.
# ==============================================================================

# Application Environment Configuration
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
PROJECT_NAME="AI-Powered Malicious File Forensics and Threat Reconstruction System"
UNIVERSITY="SRM University Delhi-NCR, Sonipat"
SESSION="2026-2027"

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Storage & Quarantine (Stored outside public web directory)
UPLOAD_DIR=data/uploads
QUARANTINE_DIR=data/quarantine
REPORTS_DIR=reports/generated
MAX_UPLOAD_SIZE_MB=50

# Database Configuration (SQLite default; PostgreSQL ready)
DATABASE_URL=sqlite+aiosqlite:///./forensics.sqlite3

# ==============================================================================
# 100% FREE AI & MACHINE LEARNING MODELS (BUILT-IN ZERO-COST ENGINES)
# ==============================================================================
ML_MODEL_DIR=ml/artifacts
RANDOM_FOREST_MODEL=ml/artifacts/random_forest_model.joblib
ISOLATION_FOREST_MODEL=ml/artifacts/isolation_forest_model.joblib
FEATURE_SCALER=ml/artifacts/feature_scaler.joblib
METRICS_REPORT=ml/artifacts/evaluation_metrics.json

# YARA Rules (Free Malware Signatures)
YARA_RULES_PATH=yara_rules/malware_rules.yar

# Free Local LLM / Ollama Configuration (Optional, 100% Free)
OLLAMA_ENABLED=False
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest
OLLAMA_TIMEOUT_SECONDS=45

# ==============================================================================
# GOOGLE GMAIL OAUTH 2.0 INTEGRATION (FREE GOOGLE CLOUD TIER)
# ==============================================================================
# Paste your credentials from Google Cloud Console (APIs & Services > Credentials).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/email/gmail/oauth/callback"
